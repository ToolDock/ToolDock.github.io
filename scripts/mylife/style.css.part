:root{
    --ink:#222; --ink-strong:#111; --ink-deep:#0f172a; --ink-sub:#555; --ink-mute:#777;
    --line:#d6dbe2; --line-soft:#dfe4ea; --head-bg:#eceff3; --tint:#fafcff;
    --dash:#b8c2d1; --accent:#2563eb;
    --up:#15803d; --down:#b91c1c;
}
*{ box-sizing:border-box; }
body{
    margin:0; padding:0 0 48px;
    font-family:"Hiragino Kaku Gothic ProN","Hiragino Sans","BIZ UDPGothic","Yu Gothic Medium","Yu Gothic",Meiryo,sans-serif;
    color:var(--ink); line-height:1.75; background:#f5f5f5;
}
.page-wrapper{ max-width:1000px; margin:0 auto; padding:0 16px; }
header{ background:var(--ink); color:#fff; padding:20px 16px; margin-bottom:22px; }
header .page-wrapper{ padding:0; }
h1{ margin:0; font-size:1.35rem; line-height:1.5; }
header p{ margin:6px 0 0; font-size:0.9rem; color:#cbd5e1; }
h2{ margin:34px 0 12px; padding-bottom:6px; font-size:1.15rem; color:var(--ink-strong);
    border-bottom:2px solid var(--line); }
h3{ margin:22px 0 8px; padding-left:10px; font-size:1.02rem; color:var(--ink-strong);
    border-left:4px solid var(--accent); }
p{ margin:0 0 12px; }

/* 表が器より広いときは、表の中だけ横に流す */
.scroll{ overflow-x:auto; -webkit-overflow-scrolling:touch; }

.tbl{ width:100%; border-collapse:collapse; background:#fff; font-size:0.93rem; }
.tbl caption{ text-align:left; padding:8px 0; font-weight:bold; color:var(--ink-deep); }
.tbl th,.tbl td{ border:1px solid var(--line-soft); padding:7px 10px; text-align:left;
                 white-space:nowrap; }
.tbl thead th{ background:var(--head-bg); color:var(--ink-deep); font-size:0.88rem; }
.tbl tbody th{ background:var(--tint); font-weight:600; }
.tbl td.n{ text-align:right; font-variant-numeric:tabular-nums; }
.tbl td.up{ color:var(--up); font-weight:600; }
.tbl td.down{ color:var(--down); font-weight:600; }
.tbl td.zero{ color:var(--ink-mute); }
.tbl tr.dim th,.tbl tr.dim td{ color:var(--ink-mute); background:#fbfcfd; }
.points th[scope="row"]{ white-space:nowrap; }

/* 成長タイプ表は条件の欄が長い。折り返さないと右の列が見切れる */
.growth td{ white-space:normal; }
.growth td:first-of-type{ min-width:190px; }

/* 横に流れる表には、その旨を出す */
.scroll-hint{ margin:0 0 6px; font-size:0.8rem; color:var(--ink-mute); }

/* ── 計算機 ───────────────────────────── */
.sim{ background:#fff; border:1px solid var(--line); border-radius:12px; padding:16px; }
.sim__form{ display:grid; gap:12px; grid-template-columns:1fr; }
@media (min-width:700px){ .sim__form{ grid-template-columns:repeat(2,1fr); } }
.field{ display:flex; flex-direction:column; gap:5px; }
.field label{ font-size:0.85rem; font-weight:600; color:var(--ink-sub); }
.field select{ font:inherit; font-size:0.95rem; padding:8px 10px; border:1px solid var(--line);
               border-radius:8px; background:#fff; color:var(--ink); width:100%; }
.seg{ display:flex; gap:6px; }
.seg button{ flex:1; font:inherit; font-size:0.95rem; font-weight:600; padding:9px 10px;
             border:1px solid var(--line); border-radius:8px; background:#fff;
             color:var(--ink-sub); cursor:pointer; }
.seg button[aria-pressed="true"]{ background:var(--ink); border-color:var(--ink); color:#fff; }

.result{ margin-top:16px; border-top:1px dashed var(--dash); padding-top:14px; }
.result__head{ display:flex; flex-wrap:wrap; gap:8px 20px; margin-bottom:12px; font-size:0.92rem; }
.result__head b{ color:var(--ink-deep); }
.stats{ display:grid; gap:8px; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); }
.stat{ border:1px solid var(--line-soft); border-radius:8px; padding:8px 10px; background:var(--tint); }
.stat__k{ font-size:0.78rem; color:var(--ink-sub); }
.stat__v{ font-size:1.3rem; font-weight:700; line-height:1.3; font-variant-numeric:tabular-nums; }
.stat__b{ font-size:0.76rem; color:var(--ink-mute); font-variant-numeric:tabular-nums; }
.skills{ margin-top:12px; font-size:0.9rem; }
.skills b{ color:var(--ink-deep); }
.note{ margin-top:10px; font-size:0.82rem; color:var(--ink-mute); }

.tool-article{ margin-top:34px; }
.tool-article table{ margin-bottom:14px; }
